{
  "name": "ace",
  "version": "0.0.1",
  "type": "module",
  "author": "Sanjok Mangrati",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,trigger -c auto pnpm:dev:next pnpm:dev:trigger",
    "dev:next": "next dev",
    "dev:trigger": "trigger dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --mode live contract",
    "db:push": "drizzle-kit push",
    "sandbox:snapshot": "node --env-file-if-exists=.env.local server/adapters/daytona/build-snapshot.ts",
    "auth:schema": "pnpm dlx auth@latest generate --config server/adapters/better-auth/auth.ts --output server/db/schema/auth.ts --yes && biome format --write server/db/schema/auth.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/google": "^4.0.105",
    "@ai-sdk/openai": "^4.0.102",
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@ai-sdk/otel": "^1.0.153",
    "@ai-sdk/react": "^4.0.157",
    "@base-ui/react": "^1.9.0",
    "@daytona/sdk": "0.226.1",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@hookform/resolvers": "^6.0.0",
    "@novnc/novnc": "1.7.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@phosphor-icons/react": "^2.1.10",
    "@trigger.dev/sdk": "4.8.1",
    "ai": "^7.0.153",
    "better-auth": "^1.7.13",
    "busboy": "1.6.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "form-data": "4.0.6",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.0",
    "server-only": "^0.0.1",
    "streamdown": "^2.7.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.34",
    "@biomejs/biome": "2.6.3",
    "@electric-sql/pglite": "^0.5.11",
    "@next/env": "16.4.3",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@trigger.dev/build": "4.8.1",
    "@types/node": "^24.19.2",
    "@types/novnc__novnc": "1.6.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "trigger.dev": "4.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
