{
  "name": "ace",
  "version": "0.0.1",
  "type": "module",
  "author": "Sanjok Mangrati",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check && node scripts/check-design.mjs",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "sandbox:snapshot": "node --env-file-if-exists=.env.local server/adapters/daytona/build-snapshot.ts",
    "auth:schema": "pnpm dlx auth@latest generate --config server/adapters/better-auth/auth.ts --output server/db/schema/auth.ts --yes && biome format --write server/db/schema/auth.ts",
    "lint:design": "node scripts/check-design.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/google": "^4.0.95",
    "@ai-sdk/openai": "^4.0.93",
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@ai-sdk/otel": "^1.0.140",
    "@ai-sdk/react": "^4.0.140",
    "@base-ui/react": "^1.9.0",
    "@daytona/sdk": "0.224.1",
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@trigger.dev/sdk": "4.7.4",
    "ai": "^7.0.137",
    "better-auth": "^1.7.7",
    "busboy": "1.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "form-data": "4.0.6",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "streamdown": "^2.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "^0.5.9",
    "@next/env": "16.4.0",
    "@tailwindcss/node": "^4",
    "@tailwindcss/oxide": "^4",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@trigger.dev/build": "4.7.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
