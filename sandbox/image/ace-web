#!/usr/bin/env python3
import base64
import html
import json
import re
import subprocess
import sys
import urllib.parse
import urllib.request

USER_AGENT = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
    "Chrome/130.0.0.0 Safari/537.36"
)
RESULT_LIMIT = 8
FETCH_TIMEOUT_SEC = 40
BLOCKED_TITLES = ("just a moment", "access denied", "attention required")


def fail(message):
    sys.stderr.write(message + "\n")
    sys.exit(1)


def get(url, timeout=20):
    request = urllib.request.Request(
        url, headers={"User-Agent": USER_AGENT, "Accept-Language": "en-US,en;q=0.9"}
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read().decode("utf-8", "replace")


def strip_tags(text):
    return html.unescape(re.sub(r"<[^>]+>", " ", text)).strip()


def results_from(items):
    results = []
    for title, link, snippet in items:
        title = re.sub(r"\s+", " ", title).strip()
        if not title or not link.startswith("http") or any(r["url"] == link for r in results):
            continue
        results.append({"title": title, "url": link, "snippet": re.sub(r"\s+", " ", snippet).strip()})
        if len(results) == RESULT_LIMIT:
            break
    return results


def uddg_target(href):
    return urllib.parse.parse_qs(urllib.parse.urlparse(href).query).get("uddg", [""])[0]


def duckduckgo_url(query):
    return "https://html.duckduckgo.com/html/?" + urllib.parse.urlencode({"q": query, "kl": "us-en"})


def duckduckgo_results(page):
    from bs4 import BeautifulSoup

    if "bots use DuckDuckGo" in page:
        return []
    items = []
    for result in BeautifulSoup(page, "html.parser").select("div.result"):
        anchor = result.select_one("a.result__a")
        if not anchor:
            continue
        snippet = result.select_one(".result__snippet")
        items.append((anchor.get_text(" "), uddg_target(anchor.get("href", "")), snippet.get_text(" ") if snippet else ""))
    return results_from(items)


def duckduckgo(query):
    return duckduckgo_results(get(duckduckgo_url(query)))


def duckduckgo_lite(query):
    from bs4 import BeautifulSoup

    page = get("https://lite.duckduckgo.com/lite/?" + urllib.parse.urlencode({"q": query, "kl": "us-en"}))
    soup = BeautifulSoup(page, "html.parser")
    snippets = [snippet.get_text(" ") for snippet in soup.select("td.result-snippet")]
    anchors = soup.select("a.result-link")
    snippets += [""] * (len(anchors) - len(snippets))
    return results_from(
        (anchor.get_text(" "), uddg_target(anchor.get("href", "")), snippet)
        for anchor, snippet in zip(anchors, snippets)
    )


def duckduckgo_rendered(query):
    page = chromium_dom(duckduckgo_url(query))
    return duckduckgo_results(page) if page else []


def bing_target(href):
    encoded = urllib.parse.parse_qs(urllib.parse.urlparse(href).query).get("u", [""])[0]
    if not encoded.startswith("a1"):
        return href
    encoded = encoded[2:]
    return base64.urlsafe_b64decode(encoded + "=" * (-len(encoded) % 4)).decode("utf-8", "replace")


def bing(query):
    from bs4 import BeautifulSoup

    page = get("https://www.bing.com/search?" + urllib.parse.urlencode({"q": query, "cc": "US", "setlang": "en-US"}))
    items = []
    for result in BeautifulSoup(page, "html.parser").select("li.b_algo"):
        anchor = result.select_one("h2 a")
        if not anchor:
            continue
        snippet = result.select_one(".b_caption p") or result.select_one("p")
        items.append((anchor.get_text(" "), bing_target(anchor.get("href", "")), snippet.get_text(" ") if snippet else ""))
    return results_from(items)


def search(query):
    results = []
    for engine in (duckduckgo, duckduckgo_lite, bing, duckduckgo_rendered):
        try:
            results = engine(query)
        except Exception:
            results = []
        if results:
            break
    if not results:
        fail("No results came back.")
    print(json.dumps({"results": results}))


def chromium_dom(url):
    command = [
        "chromium",
        "--headless=new",
        "--disable-gpu",
        "--window-size=1280,800",
        "--virtual-time-budget=5000",
        "--timeout=20000",
        f"--user-agent={USER_AGENT}",
        "--dump-dom",
        url,
    ]
    try:
        rendered = subprocess.run(
            command, capture_output=True, text=True, timeout=FETCH_TIMEOUT_SEC
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    if rendered.returncode == 0 and rendered.stdout.strip():
        return rendered.stdout
    return None


def render(url):
    return chromium_dom(url) or get(url)


def fetch(url):
    import trafilatura

    page = render(url)
    metadata = trafilatura.extract_metadata(page, default_url=url)
    title = metadata.title if metadata else None
    if title and title.strip().lower().startswith(BLOCKED_TITLES):
        fail("This site blocks automated reading.")
    text = trafilatura.extract(
        page,
        url=url,
        output_format="markdown",
        include_links=True,
        include_tables=True,
        include_formatting=True,
    )
    if not text:
        text = re.sub(r"\s+\n", "\n", strip_tags(re.sub(r"(?is)<(script|style).*?</\1>", " ", page)))
    if not text.strip():
        fail("The page had no readable text.")
    print(json.dumps({"title": title, "url": url, "text": text}))


if __name__ == "__main__":
    if len(sys.argv) != 3 or sys.argv[1] not in ("search", "fetch"):
        fail("Usage: ace-web search QUERY | ace-web fetch URL")
    try:
        (search if sys.argv[1] == "search" else fetch)(sys.argv[2])
    except Exception as error:
        fail(f"{type(error).__name__}: {error}")
